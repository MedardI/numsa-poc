# Copy to .env and adjust. Read on startup via `node --env-file-if-exists=.env`.
PORT=3000
# First approver account - only used when the database has no users yet.
ADMIN_EMAIL=admin@numsa.local
ADMIN_PASSWORD=change-this-password
# Set to false to require a second approver for documents an approver uploaded themselves.
ALLOW_SELF_APPROVAL=true
MAX_UPLOAD_MB=25
# Where the SQLite database and uploaded files are kept.
# DATA_DIR=./data
# NODE_ENV=production   # marks the session cookie Secure (serve over HTTPS)
